<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="xleguisamoExamen.Views.Resumen"
             Title="Resumen">
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <!-- Usuario Conectado -->
            <Label x:Name="lblUsuarioConectado" FontSize="14" FontAttributes="Bold" TextColor="Gray" />

            <!-- Título de la vista -->
            <Label Text="RESUMEN" Style="{StaticResource GlobalTitleStyle}" FontSize="24" TextColor="DarkBlue" />

            <!-- Grid 9 Filas x 2 Columnas -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                  ColumnDefinitions="Auto, *" 
                  RowSpacing="8" 
                  ColumnSpacing="15">

                <Label Text="Nombre:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0" />
                <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" />

                <Label Text="Apellido:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" />
                <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" />

                <Label Text="Edad:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0" />
                <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" />

                <Label Text="Fecha de inicio:" FontAttributes="Bold" Grid.Row="3" Grid.Column="0" />
                <Label x:Name="lblFechaInicio" Grid.Row="3" Grid.Column="1" />

                <Label Text="Plan:" FontAttributes="Bold" Grid.Row="4" Grid.Column="0" />
                <Label x:Name="lblPlan" Grid.Row="4" Grid.Column="1" />

                <Label Text="Casillero:" FontAttributes="Bold" Grid.Row="5" Grid.Column="0" />
                <Label x:Name="lblCasillero" Grid.Row="5" Grid.Column="1" />

                <Label Text="Monto Inicial:" FontAttributes="Bold" Grid.Row="6" Grid.Column="0" />
                <Label x:Name="lblMontoInicial" Grid.Row="6" Grid.Column="1" />

                <Label Text="Pago Mensual (x5):" FontAttributes="Bold" Grid.Row="7" Grid.Column="0" />
                <Label x:Name="lblPagoMensual" Grid.Row="7" Grid.Column="1" />

                <Label Text="Pago Total:" FontAttributes="Bold" Grid.Row="8" Grid.Column="0" />
                <Label x:Name="lblPagoTotal" Grid.Row="8" Grid.Column="1" FontAttributes="Bold" TextColor="Green" />
            </Grid>

            <!-- Botones -->
            <Button Text="Nuevo registro" Clicked="OnNuevoRegistroClicked" Style="{StaticResource GlobalButtonStyle}" />
            <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" BackgroundColor="Red" TextColor="White" FontAttributes="Bold" />
        </StackLayout>
    </ScrollView>

</ContentPage>